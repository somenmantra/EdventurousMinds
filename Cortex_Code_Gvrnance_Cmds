--Create a custom ROLE.
CREATE ROLE RL_CORTEX_CODE_STD;
GRANT USAGE ON WAREHOUSE COMPUTE_WH TO ROLE RL_CORTEX_CODE_STD;


--Create a custom user.
CREATE USER user_custom_demo_02
  PASSWORD = 'XXXXXXXXXX'
  DEFAULT_ROLE = RL_CORTEX_CODE_STD
  DEFAULT_WAREHOUSE = COMPUTE_WH
  MUST_CHANGE_PASSWORD = FALSE
  COMMENT = 'Custom user for Cortex Code governance testing';

--Grant the role to the same user now:
GRANT ROLE RL_CORTEX_CODE_STD TO USER user_custom_demo_02;


--JUST GIVE CLI/SNOWSIGHT ACCESS AS APPLICABLE.

-- Enable CLI only, block the Snowsight entry point:
GRANT DATABASE ROLE SNOWFLAKE.CORTEX_USER TO ROLE RL_CORTEX_CODE_STD;

-- Enable CLI & Snowsight:
GRANT DATABASE ROLE SNOWFLAKE.CORTEX_USER  TO ROLE RL_CORTEX_CODE_STD;
GRANT DATABASE ROLE SNOWFLAKE.COPILOT_USER TO ROLE RL_CORTEX_CODE_STD;


--Governing all model access at an account level.
ALTER ACCOUNT SET CORTEX_MODELS_ALLOWLIST = 'ALL';
ALTER ACCOUNT SET CORTEX_MODELS_ALLOWLIST = 'None';

ALTER ACCOUNT SET CORTEX_MODELS_ALLOWLIST = 'openai-gpt-5.2';
ALTER ACCOUNT SET CORTEX_MODELS_ALLOWLIST = 'CLAUDE-SONNET-4-5';



--Check for all the model access in an account along with their roles.
CALL SNOWFLAKE.MODELS.CORTEX_BASE_MODELS_REFRESH();
SHOW MODELS IN SCHEMA SNOWFLAKE.MODELS;



--Check for all the model access in an account along with their roles.
SHOW APPLICATION ROLES IN APPLICATION SNOWFLAKE;


--Just give fine grained model level RBAC access as applicable.

--GRANT APPLICATION ROLE SNOWFLAKE."CORTEX-MODEL-ROLE-OPENAI-GPT-5.2"  TO ROLE RL_CORTEX_CODE_STD;
GRANT APPLICATION ROLE SNOWFLAKE."CORTEX-MODEL-ROLE-CLAUDE-SONNET-4-5" TO ROLE RL_CORTEX_CODE_STD;

--REVOKE APPLICATION ROLE SNOWFLAKE."CORTEX-MODEL-ROLE-OPENAI-GPT-5.2"  FROM ROLE RL_CORTEX_CODE_STD;
REVOKE APPLICATION ROLE SNOWFLAKE."CORTEX-MODEL-ROLE-CLAUDE-SONNET-4-5" FROM ROLE RL_CORTEX_CODE_STD;




--Control the cortex code limit at the user level too.
ALTER ACCOUNT SET CORTEX_CODE_CLI_DAILY_EST_CREDIT_LIMIT_PER_USER      = 20;
ALTER ACCOUNT SET CORTEX_CODE_SNOWSIGHT_DAILY_EST_CREDIT_LIMIT_PER_USER = 20;

ALTER USER user_custom_demo_01 SET CORTEX_CODE_CLI_DAILY_EST_CREDIT_LIMIT_PER_USER = 10;
ALTER USER user_custom_demo_01 SET CORTEX_CODE_SNOWSIGHT_DAILY_EST_CREDIT_LIMIT_PER_USER = 10;


