/* =====================================================================
   STEP 0 - SETUP
   - AI SQL = LLMs callable as plain SQL functions. No Python, no APIs.
   - Data never leaves Snowflake's security boundary.
   - We build 2 small tables + 1 stage with a PDF and an image.
   ===================================================================== */
USE ROLE ACCOUNTADMIN;
USE WAREHOUSE COMPUTE_WH;
CREATE DATABASE IF NOT EXISTS AI_DEMO_DB;
CREATE SCHEMA IF NOT EXISTS AI_DEMO_DB.DEMO;
USE SCHEMA AI_DEMO_DB.DEMO;

-- Stage for unstructured files (PDF, image, audio). Server-side encryption + directory are required for AI file functions.
CREATE STAGE IF NOT EXISTS AI_DEMO_DB.DEMO.DOCS_STAGE
  DIRECTORY = (ENABLE = TRUE) ENCRYPTION = (TYPE = 'SNOWFLAKE_SSE');
-- Files used: invoice_1001.pdf, product.png (+ optional call.mp3 you upload via Snowsight > Data > Stage > + Files)
LIST @AI_DEMO_DB.DEMO.DOCS_STAGE;

